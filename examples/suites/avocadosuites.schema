{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://avocado-project.org/avocado-suites-v1.schema.json",
    "title": "avocado-suites",
    "description": "Description of suites to be run in an Avocado Job",
    "type": "object",
    "properties": {
        "version": {
            "description": "A descriptive magic number for this file format",
            "const": "AVOCADO_SUITES_V1",
            "type": "string"
        },
        "suites": {
            "description": "One or more test suites",
            "type": "array",
            "minItems": 1,
            "uniqueItems": false,
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "description": "The name of the test suite",
                        "type": "string"
                    },
                    "runnables": {
                        "description": "The runnables for the test suite",
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": false
                    },
                    "required": [ "name", "runnables" ]
                }
            }
        }
    }
    "required": [ "version", "suites" ],
}
